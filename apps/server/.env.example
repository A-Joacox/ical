# Copia este archivo como apps/server/.env y rellénalo. Nunca lo subas a git.

# Dominio público de la app, sin https://. Las passkeys quedan ligadas a él.
RP_ID=<host>.<tailnet>.ts.net
ORIGIN=https://<host>.<tailnet>.ts.net

# Firma las sesiones; cambiarlo cierra todas las sesiones. Genera con: openssl rand -base64 32
SESSION_SECRET=
# Código para registrar la primera passkey desde la app (lo escribes en el iPhone).
# Genera con: openssl rand -hex 12. Puedes borrarlo después de registrar tus dispositivos.
SETUP_TOKEN=

# Notificaciones push (descanso del gym y alertas del server). Genera el par con:
# docker compose run --rm --no-deps app node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opcional: alimentos genéricos de USDA (en inglés) en la búsqueda de comida. Clave gratis en
# https://fdc.nal.usda.gov/api-key-signup (llega por correo).
USDA_API_KEY=

# Opcional: análisis de fotos de comida con Gemini (free tier). Clave gratis en
# https://aistudio.google.com/apikey. En el plan gratuito Google puede usar las fotos para mejorar
# sus modelos. GEMINI_MODEL es opcional; por defecto, el último Flash (gemini-flash-latest).
GEMINI_API_KEY=
GEMINI_MODEL=

# Opcional: tus calendarios de Google, de solo lectura. En Google Calendar (web) → Configuración →
# cada calendario → "Dirección secreta en formato iCal". Varias separadas por espacio o coma.
# Son secretas: quien las tenga ve tus eventos.
CALENDAR_ICS_URLS=
